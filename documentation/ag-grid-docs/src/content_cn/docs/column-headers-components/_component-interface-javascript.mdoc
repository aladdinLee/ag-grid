{% if isFramework("javascript") %}

```ts
interface IHeaderComp {
    // 可选方法，使用参数调用一次
    init?(params: IHeaderParams): void;

    // 返回组件的 DOM 元素，这是表格放入 DOM 的内容
    // 可以多次调用
    getGui(): HTMLElement;

    // 当为此标题设置了新的列定义时调用。
    // 如果您处理标题的刷新，则返回 true，否则返回 false，
    // 表格将从头重新创建您的标题。
    refresh(params: IHeaderParams): boolean;

    // 表格移除组件时调用一次；如果您的组件需要做任何清理工作，请在这里进行
    destroy?(): void;
}
```

{% /if %}
