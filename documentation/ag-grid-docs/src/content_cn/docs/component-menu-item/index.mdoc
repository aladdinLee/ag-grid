---
title: "菜单项组件"
enterprise: true
---

菜单项组件允许您自定义[列菜单](./column-menu/)和[上下文菜单](./context-menu/)中显示的菜单项。当提供的菜单项不能满足您的需求时，请使用这些组件。

以下示例演示了在列菜单和上下文菜单中的自定义菜单项组件。点击自定义菜单项中的按钮将在开发者控制台中记录日志。

{% gridExampleRunner title="自定义菜单项组件" name="custom-menu-item" /%}

{% if isFramework("javascript", "angular", "vue") %}
实现此接口以提供自定义菜单项。
{% /if %}

{% if isFramework("angular") %}

```ts
interface extends IMenuItemAngularComp {
    // 必需方法

    // agInit(params) 方法在菜单项上调用一次。
    agInit(params: IMenuItemParams);

    // 可选方法

    // 配置此项的默认网格行为，包括样式、鼠标和键盘交互。
    // 返回 `true` 使用所有默认行为，返回 `false` 不使用默认行为
    // （等同于未定义 `configureDefaults`），
    // 或返回 `IMenuConfigParams` 来选择要使用的默认行为。
    configureDefaults(): boolean | IMenuConfigParams;

    // 当项目被激活/停用时调用，通过鼠标悬停或键盘导航触发。
    setActive(active: boolean): void;

    // 如果项目有子菜单，当子菜单打开/关闭时调用。
    setExpanded(expanded: boolean): void;

    // 当项目被选中时调用，例如点击或按下 Enter 键。
    select(): void;
}
```

{% /if %}

{% if isFramework("javascript") %}

```ts
interface IMenuItemComp {
    // 必需方法

    // 返回此菜单项的 DOM 元素
    getGui(): HTMLElement;

    // 可选方法

    // init(params) 方法在菜单项上调用一次。有关参数的详细信息，请参见下文。
    init(params: IMenuItemParams): void;

    // 配置此项的默认网格行为，包括样式、鼠标和键盘交互。
    // 返回 `true` 使用所有默认行为，返回 `false` 不使用默认行为
    // （等同于未定义 `configureDefaults`），
    // 或返回 `IMenuConfigParams` 来选择要使用的默认行为。
    configureDefaults(): boolean | IMenuConfigParams;

    // 当项目被激活/停用时调用，通过鼠标悬停或键盘导航触发。
    setActive(active: boolean): void;

    // 如果项目有子菜单，当子菜单打开/关闭时调用。
    setExpanded(expanded: boolean): void;

    // 当项目被选中时调用，例如点击或按下 Enter 键。
    select(): void;
}
```

{% /if %}

{% if isFramework("vue") %}

```ts
interface IMenuItem {
    // 可选方法

    // 配置此项的默认网格行为，包括样式、鼠标和键盘交互。
    // 返回 `true` 使用所有默认行为，返回 `false` 不使用默认行为
    // （等同于未定义 `configureDefaults`），
    // 或返回 `IMenuConfigParams` 来选择要使用的默认行为。
    configureDefaults(): boolean | IMenuConfigParams;

    // 当项目被激活/停用时调用，通过鼠标悬停或键盘导航触发。
    setActive(active: boolean): void;

    // 如果项目有子菜单，当子菜单打开/关闭时调用。
    setExpanded(expanded: boolean): void;

    // 当项目被选中时调用，例如点击或按下 Enter 键。
    select(): void;
}
```

{% /if %}

{% if isFramework("react") %}

```jsx
export default ({ name, icon, shortcut, subMenu }) => {
    useGridMenuItem(() => {
        configureDefaults: () => true;
    });
    return (
        <div>
            <span className="ag-menu-option-part ag-menu-option-icon">{icon}</span>
            <span className="ag-menu-option-part ag-menu-option-text">{name}</span>
            <span className="ag-menu-option-part ag-menu-option-shortcut">{shortcut}</span>
            <span className="ag-menu-option-part ag-menu-option-popup-pointer">{subMenu ? '>': ''}</span>
        </div>
    );
};
```

{% /if %}

