在 60 秒内将 AG Grid 添加到您的应用程序中：

{% if isFramework("react", "angular", "vue") %}

{% numberHeading number="1" title="NPM 安装" level="h3" %}

{% if isFramework("react") %}

<!-- Install React -->

安装 `ag-grid-react` 包，这也会安装 `ag-grid-community`：

```bash
npm install ag-grid-react
```

{% /if %}

{% if isFramework("angular") %}

<!-- Install Angular -->

安装 `ag-grid-angular` 包，这也会安装 `ag-grid-community`：

```bash
npm install ag-grid-angular
```

{% /if %}

{% if isFramework("vue") %}

<!-- Install Vue3 -->

安装 `ag-grid-vue3` 包，这也会安装 `ag-grid-community`：

```bash
npm install ag-grid-vue3
```

{% /if %}

{% /numberHeading %}

{% /if %}

{% if isFramework("javascript") %}
{% numberHeading number="1" title="提供容器" level="h3" %}

<!-- Create JavaScript -->

加载 AG Grid 库并创建一个容器 div。该 div 应该有高度，因为数据表格将填充父容器的大小：

```html
<html lang="en">
    <head>
        <!-- 包含 JavaScript 数据表格的所有 JS 和 CSS -->
        <script src="https://cdn.jsdelivr.net/npm/ag-grid-community/dist/ag-grid-community.min.js"></script>
    </head>
    <body>
        <!-- 您的数据表格容器 -->
        <div id="myGrid" style="height: 500px"></div>
    </body>
</html>
```

{% note %}
如果您使用 TypeScript，则需要导入并注册要使用的模块。有关更多信息，请参阅 [NPM 安装](./installation/#npm-installation) 文档。
{% /note %}

{% /numberHeading %}
{% /if %}

{% if isFramework("javascript") %}
{% numberHeading number="2" title="实例化 JavaScript 数据表格" level="h3" %}

使用 `createGrid` 在容器 div 内创建数据表格。

```js
// Grid Options：包含所有数据表格配置
const gridOptions = {};

// 您的 JavaScript 代码用于创建数据表格
const myGridElement = document.querySelector('#myGrid');
agGrid.createGrid(myGridElement, gridOptions);
```

{% /numberHeading %}
{% /if %}

{% if isFramework("javascript") %}
{% numberHeading number="3" title="定义行和列" level="h3" %}

```js
// Grid Options：包含所有数据表格配置
const gridOptions = {
    // Row Data：要显示的数据。
    rowData: [
        { make: "Tesla", model: "Model Y", price: 64950, electric: true },
        { make: "Ford", model: "F-Series", price: 33850, electric: false },
        { make: "Toyota", model: "Corolla", price: 29600, electric: false },
    ],
    // Column Definitions：定义要显示的列。
    columnDefs: [
        { field: "make" },
        { field: "model" },
        { field: "price" },
        { field: "electric" }
    ]
};
```

{% /numberHeading %}
{% /if %}

{% if isFramework("react") %}

<!-- Create React -->

{% numberHeading number="2" title="提供模块" level="h3" %}

将 `AllCommunityModule` 传递给 `AgGridProvider` 以访问所有社区功能：

```js
import { AllCommunityModule } from 'ag-grid-community';
import { AgGridProvider } from 'ag-grid-react';

const modules = [AllCommunityModule];

function App() {
    return (
        <AgGridProvider modules={modules}>
            {/* 您的 AgGridReact 组件放在这里 */}
        </AgGridProvider>
    );
}
```

{% note %}
为了最小化包大小，只提供您想要使用的模块。有关更多信息，请参阅 [模块](./modules/) 文档。
{% /note %}
{% /numberHeading %}

{% numberHeading number="3" title="导入 React 数据表格" level="h3" %}

```js
import { AgGridReact } from 'ag-grid-react'; // React 数据表格组件
```

{% /numberHeading %}

{% numberHeading number="4" title="定义行和列" level="h3" %}

```js
const GridExample = () => {
    // Row Data：要显示的数据。
    const [rowData, setRowData] = useState([
        { make: "Tesla", model: "Model Y", price: 64950, electric: true },
        { make: "Ford", model: "F-Series", price: 33850, electric: false },
        { make: "Toyota", model: "Corolla", price: 29600, electric: false },
    ]);

    // Column Definitions：定义要显示的列。
    const [colDefs, setColDefs] = useState([
        { field: "make" },
        { field: "model" },
        { field: "price" },
        { field: "electric" }
    ]);

    // ...
}
```

{% /numberHeading %}

{% numberHeading number="5" title="React 数据表格组件" level="h3" %}

在 `AgGridProvider` 内返回 `AgGridReact` 组件，包装在一个具有固定高度的父容器 `div` 中：

```jsx
const modules = [AllCommunityModule];

return (
    <AgGridProvider modules={modules}>
        {/* 数据表格将填充父容器的大小 */}
        <div style={{ height: 500 }}>
            <AgGridReact
                rowData={rowData}
                columnDefs={colDefs}
            />
        </div>
    </AgGridProvider>
)
```

{% /numberHeading %}
{% /if %}

{% if isFramework("angular") %}
{% numberHeading number="2" title="注册模块" level="h3" %}

注册 `AllCommunityModule` 以访问所有社区功能：

```js
import { AllCommunityModule, ModuleRegistry } from 'ag-grid-community';

// 注册所有社区功能
ModuleRegistry.registerModules([AllCommunityModule]);
```

{% note %}
为了最小化包大小，只注册您想要使用的模块。有关更多信息，请参阅 [模块](./modules/) 页面。
{% /note %}
{% /numberHeading %}
{% /if %}

{% if isFramework("angular") %}
{% numberHeading number="3" title="导入 Angular 数据表格" level="h3" %}

```js
import { AgGridAngular } from 'ag-grid-angular'; // Angular 数据表格组件
import type { ColDef } from 'ag-grid-community'; // 列定义类型接口
```

{% /numberHeading %}
{% /if %}

{% if isFramework("angular") %}
{% numberHeading number="4" title="定义行和列" level="h3" %}

```jsx
@Component({
    selector: 'app-root',
    standalone: true,
    imports: [AgGridAngular], // 添加 Angular 数据表格组件
    styleUrls: ['./app.component.css'],
    template: ``
})

export class AppComponent {
    // Row Data：要显示的数据。
    rowData = [
        { make: "Tesla", model: "Model Y", price: 64950, electric: true },
        { make: "Ford", model: "F-Series", price: 33850, electric: false },
        { make: "Toyota", model: "Corolla", price: 29600, electric: false },
    ];

    // Column Definitions：定义要显示的列。
    colDefs: ColDef[] = [
        { field: "make" },
        { field: "model" },
        { field: "price" },
        { field: "electric" }
    ];
}
```

{% /numberHeading %}
{% /if %}

{% if isFramework("angular") %}
{% numberHeading number="5" title="Angular 数据表格组件" level="h3" %}

将行和列设置为 `ag-grid-angular` 组件属性：

```js
template:
`
    <!-- AG Grid 组件 -->
    <ag-grid-angular
        [rowData]="rowData"
        [columnDefs]="colDefs" />
`
```

{% /numberHeading %}
{% /if %}

{% if isFramework("vue") %}
{% numberHeading number="2" title="注册模块" level="h3" %}
注册 `AllCommunityModule` 以访问所有社区功能：

```js
import { AllCommunityModule, ModuleRegistry } from 'ag-grid-community';

// 注册所有社区功能
ModuleRegistry.registerModules([AllCommunityModule]);
```

{% note %}
为了最小化包大小，只注册您想要使用的模块。有关更多信息，请参阅 [模块](./modules/) 页面。
{% /note %}

{% /numberHeading %}
{% /if %}

{% if isFramework("vue") %}
{% numberHeading number="3" title="导入 Vue 数据表格" level="h3" %}

```html
<script>
import { AgGridVue } from "ag-grid-vue3"; // Vue 数据表格组件

export default {
    name: "App",
    components: {
        AgGridVue, // 添加 Vue 数据表格组件
    },
    setup() {},
};
</script>
```

{% /numberHeading %}
{% /if %}

{% if isFramework("vue") %}
{% numberHeading number="4" title="定义行和列" level="h3" %}

```js
setup() {
    // Row Data：要显示的数据。
    const rowData = ref([
        { make: "Tesla", model: "Model Y", price: 64950, electric: true },
        { make: "Ford", model: "F-Series", price: 33850, electric: false },
        { make: "Toyota", model: "Corolla", price: 29600, electric: false },
    ]);

    // Column Definitions：定义要显示的列。
    const colDefs = ref([
        { field: "make" },
        { field: "model" },
        { field: "price" },
        { field: "electric" }
    ]);

    return {
        rowData,
        colDefs,
    };
},
```

{% /numberHeading %}
{% /if %}

{% if isFramework("vue") %}
{% numberHeading number="5" title="Vue 数据表格组件" level="h3" %}

将行和列设置为 `ag-grid-vue` 组件属性。通过 class 和 style 属性应用样式。

```html
<template>
    <!-- AG Grid 组件 -->
    <ag-grid-vue
        :rowData="rowData"
        :columnDefs="colDefs"
        style="height: 500px"
    >
    </ag-grid-vue>
</template>
```

{% /numberHeading %}
{% /if %}

