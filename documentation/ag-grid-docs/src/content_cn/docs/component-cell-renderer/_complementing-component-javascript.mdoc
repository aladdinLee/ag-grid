{% if isFramework("javascript") %}

```js
// 定义要重用的单元格渲染器
const myCellRenderer = params => `<span style="color: ${params.color}">${params.value}</span>`;

// 使用一种颜色
colDef.cellRenderer = myCellRenderer;
colDef.cellRendererParams = {
    color: 'guinnessBlack'
}

// 使用另一种颜色
colDef.cellRenderer = myCellRenderer;
colDef.cellRendererParams = {
    color: 'irishGreen'
}
```

{% /if %}
