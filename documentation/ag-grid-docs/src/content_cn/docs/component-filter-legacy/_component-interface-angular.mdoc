{% if isFramework("angular") %}
自定义筛选器组件的接口如下：
{% /if %}

{% if isFramework("angular") %}

```ts
interface IFilterAngularComp {
    // 必需 - 筛选操作的参数（有关更多详细信息，请参见下文）
    agInit(params: IFilterParams): void;

    // 如果筛选器处于活动状态，则返回 true。如果处于活动状态，则 1) 网格将在列标题中显示筛选器图标，
    // 2) 筛选器将包含在数据筛选中。
    isFilterActive(): boolean;

    // 网格将依次询问每个活动筛选器，网格中的每一行是否通过。如果任何
    // 筛选器失败，则该行将从最终集合中排除。提供了一个参数对象，
    // 包含 node（网格创建的包装数据的 rowNode）和 data（您为该行提供给网格的数据对象）的属性。
    // 请注意，这仅针对客户端行模型调用，如果仅与其他行模型一起使用，可以只返回 `true`。
    doesFilterPass(params: IDoesFilterPassParams): boolean;

    // 获取筛选器状态。如果筛选器未处于活动状态，则应返回 null/undefined。
    // 当调用 gridApi.getFilterModel() 时，网格会在所有活动筛选器上调用 getModel()。
    getModel(): any;

    // 恢复筛选器状态。在调用 gridApi.setFilterModel(model) 后由网格调用。
    // 网格将传递 undefined/null 以清除筛选器。
    setModel(model: any): void;


    // 可选方法

    // 每次显示弹出窗口时都会调用，在 getGui 返回的 GUI 附加到 DOM 之后。
    // 如果筛选器弹出窗口关闭并重新打开，则每次显示筛选器时都会调用此方法。
    // 这对于任何需要在执行之前附加的逻辑很有用，例如将焦点放在特定的 DOM 元素上。
    // 参数有一个回调方法 'hidePopup'，您可以在以后的任何时间调用它来隐藏弹出窗口 - 如果
    // 您有一个 'Apply' 按钮并且想在按下后隐藏弹出窗口，这很有用。
    afterGuiAttached?(params?: IAfterGuiAttachedParams): void;

    // 每次隐藏弹出窗口时都会调用，在 getGui 返回的 GUI 从 DOM 分离之后。
    // 如果筛选器弹出窗口关闭并重新打开，则每次隐藏筛选器时都会调用此方法。
    // 这对于任何将 UI 状态重置回模型以便在重新打开组件之前的逻辑很有用。
    afterGuiDetached?(): void;

    // 当新行插入到网格中时调用。如果筛选器需要在加载行后更改其
    // 状态，可以在此处进行。例如，集合筛选器使用此方法
    // 更新可供选择的值列表（例如，国家筛选器的 'Ireland'、'UK' 等）。
    // 要从客户端行模型中获取可用值列表，请使用 gridApi.forEachLeafNode(callback)
    onNewRowsLoaded?(): void;

    // 当任何筛选器更改时调用。
    onAnyFilterChanged?(): void;

    // 定义后，每当 colDef.filterParams 中提供的参数更改时，都会调用此方法。
    // 此方法返回的结果将确定是否应该刷新并重用筛选器，或者是否应该创建新的筛选器实例。
    //
    // 当返回 true 时，应该刷新并重用现有的筛选器实例，而不是被销毁。
    // 如果传递的新参数与现有筛选器实例兼容，这很有用。当返回 false 时，
    // 现有筛选器将被销毁，并将创建新的筛选器实例。如果您不希望重用现有筛选器实例，应该这样做。
    //
    // 当未提供此方法时，默认行为是每次 colDef.filterParams 更改时销毁并重新创建筛选器实例。
    refresh?(newParams: IFilterParams): boolean;

    // 当列被销毁时调用。如果您的自定义筛选器需要进行任何资源清理，请在此处进行。
    // 当筛选器变为"不可见"时，筛选器不会被销毁，因为 GUI 会被保留，
    // 以便在用户再次选择该筛选器时再次显示。当与筛选器关联的列被销毁时，
    // 筛选器会被销毁，无论是将新列设置到网格中，还是网格本身被销毁。
    destroy?(): void;

    // 如果为网格启用了浮动筛选器，但您没有为此列配置浮动筛选器，
    // 则网格将检查此方法。如果此方法存在，则网格将为您提供一个只读浮动筛选器，
    // 并显示此方法的结果。例如，如果您的筛选器是一个简单的筛选器，具有一个字符串输入值，
    // 您可以在此处返回简单的字符串值。
    getModelAsString?(model: any): string;
}
```

{% /if %}
